{
  "manifest_version": 2,
  "name": "copy-ui-path-lite",
  "version": "1.0.0",
  "description": "Click the icon to pick an element and copy its selector path",
  "permissions": [
    "activeTab",
    "clipboardWrite"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Pick element from page"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "copy-ui-path-lite@ui",
      "strict_min_version": "91.0"
    }
  }
}